# Copie para .env (ou rode deploy/setup.sh, que gera tudo com segredos aleatórios).
# NUNCA versionar o .env real.

# Endereço pelo qual os operadores acessam o app (usado pelo GoTrue). Ex.: https://monitoramento.safenet.local
SITE_URL=http://localhost:8080

# Portas publicadas no TrueNAS
HTTP_PORT=8080
HTTPS_PORT=8443
# nginx.http.conf (padrão) ou nginx.https.conf (exige deploy/certs/fullchain.pem e privkey.pem)
NGINX_CONF=nginx.http.conf

# Segredos (gerados por deploy/setup.sh)
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
