# Copie para .env (ou rode deploy/setup.sh, que gera tudo com segredos aleatórios).
# NUNCA versionar o .env real.

# Endereço pelo qual navegadores e apps acessam o Keycloak (com porta). Ex.: http://192.168.0.171:8180
KEYCLOAK_URL=http://192.168.0.171:8180

# Portas publicadas na TrueNAS
HTTP_PORT=8180
HTTPS_PORT=8543

# Segredos (gerados por deploy/setup.sh)
KC_DB_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
